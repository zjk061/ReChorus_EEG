# Generated dataset/cache files.
# Keep dataset documentation in git, but do not commit full data dumps or reader caches.
src/data/**/*.csv
src/data/**/*.pkl
src/data/**/*.pickle
data/**/*.csv
data/**/*.pkl
data/**/*.pickle

